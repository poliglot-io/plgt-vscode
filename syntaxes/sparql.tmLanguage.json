{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SPARQL",
  "scopeName": "source.sparql",
  "fileTypes": ["rq"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#prefix-directive" },
    { "include": "#keyword-form" },
    { "include": "#keyword-clause" },
    { "include": "#keyword-modifier" },
    { "include": "#keyword-aggregate" },
    { "include": "#keyword-builtin" },
    { "include": "#keyword-update" },
    { "include": "#json-dsl-keyword" },
    { "include": "#iri" },
    { "include": "#string-triple-double" },
    { "include": "#string-triple-single" },
    { "include": "#string-double" },
    { "include": "#string-single" },
    { "include": "#number" },
    { "include": "#boolean" },
    { "include": "#variable" },
    { "include": "#a-keyword" },
    { "include": "#blank-node-label" },
    { "include": "#prefixed-name" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.sparql",
      "match": "#.*$"
    },
    "prefix-directive": {
      "name": "meta.directive.sparql",
      "begin": "(?i)\\b(PREFIX|BASE)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.sparql" }
      },
      "end": "(?=$|\\b(?:SELECT|CONSTRUCT|ASK|DESCRIBE|INSERT|DELETE|JSON|WHERE|PREFIX|BASE)\\b)",
      "patterns": [
        { "include": "#iri" },
        {
          "name": "entity.name.function.sparql",
          "match": "[A-Za-z_][\\w\\-]*:"
        }
      ]
    },
    "keyword-form": {
      "name": "keyword.control.query-form.sparql",
      "match": "(?i)\\b(SELECT|CONSTRUCT|ASK|DESCRIBE)\\b"
    },
    "keyword-clause": {
      "name": "keyword.control.clause.sparql",
      "match": "(?i)\\b(WHERE|FROM|FROM\\s+NAMED|GRAPH|OPTIONAL|UNION|MINUS|FILTER|BIND|VALUES|SERVICE|EXISTS|NOT\\s+EXISTS)\\b"
    },
    "keyword-modifier": {
      "name": "keyword.control.modifier.sparql",
      "match": "(?i)\\b(ORDER\\s+BY|GROUP\\s+BY|HAVING|LIMIT|OFFSET|DISTINCT|REDUCED|AS|ASC|DESC)\\b"
    },
    "keyword-aggregate": {
      "name": "support.function.aggregate.sparql",
      "match": "(?i)\\b(COUNT|SUM|MIN|MAX|AVG|SAMPLE|GROUP_CONCAT)\\b(?=\\s*\\()"
    },
    "keyword-builtin": {
      "name": "support.function.builtin.sparql",
      "match": "(?i)\\b(STR|LANG|LANGMATCHES|DATATYPE|BOUND|IRI|URI|BNODE|RAND|ABS|CEIL|FLOOR|ROUND|CONCAT|STRLEN|UCASE|LCASE|ENCODE_FOR_URI|CONTAINS|STRSTARTS|STRENDS|STRBEFORE|STRAFTER|YEAR|MONTH|DAY|HOURS|MINUTES|SECONDS|TIMEZONE|TZ|NOW|UUID|STRUUID|MD5|SHA1|SHA256|SHA384|SHA512|COALESCE|IF|STRLANG|STRDT|sameTerm|isIRI|isURI|isBlank|isLiteral|isNumeric|REGEX|REPLACE|SUBSTR)\\b(?=\\s*\\()"
    },
    "keyword-update": {
      "name": "keyword.control.update.sparql",
      "match": "(?i)\\b(INSERT|DELETE|INSERT\\s+DATA|DELETE\\s+DATA|INSERT\\s+WHERE|DELETE\\s+WHERE|WITH|USING|CLEAR|DROP|CREATE|LOAD|COPY|MOVE|ADD|DEFAULT|ALL|SILENT)\\b"
    },
    "json-dsl-keyword": {
      "name": "keyword.control.json-dsl.sparql",
      "match": "\\bJSON\\b"
    },
    "iri": {
      "name": "string.unquoted.iri.sparql",
      "begin": "<(?![<>])",
      "end": ">",
      "patterns": [
        {
          "name": "constant.character.escape.sparql",
          "match": "\\\\u[0-9A-Fa-f]{4}|\\\\U[0-9A-Fa-f]{8}"
        }
      ]
    },
    "string-triple-double": {
      "name": "string.quoted.triple.double.sparql",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [{ "include": "#string-escape" }]
    },
    "string-triple-single": {
      "name": "string.quoted.triple.single.sparql",
      "begin": "'''",
      "end": "'''",
      "patterns": [{ "include": "#string-escape" }]
    },
    "string-double": {
      "name": "string.quoted.double.sparql",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "include": "#string-escape" }]
    },
    "string-single": {
      "name": "string.quoted.single.sparql",
      "begin": "'",
      "end": "'",
      "patterns": [{ "include": "#string-escape" }]
    },
    "string-escape": {
      "name": "constant.character.escape.sparql",
      "match": "\\\\."
    },
    "number": {
      "name": "constant.numeric.sparql",
      "match": "(?<![A-Za-z0-9_\\-])-?(?:\\d+\\.\\d*(?:[eE][+\\-]?\\d+)?|\\.\\d+(?:[eE][+\\-]?\\d+)?|\\d+(?:[eE][+\\-]?\\d+)?)\\b"
    },
    "boolean": {
      "name": "constant.language.boolean.sparql",
      "match": "(?i)\\b(true|false)\\b"
    },
    "variable": {
      "name": "variable.other.sparql",
      "match": "[?$][A-Za-z_][\\w]*"
    },
    "a-keyword": {
      "name": "entity.name.type.sparql",
      "match": "(?<![A-Za-z0-9_\\-:])a(?![A-Za-z0-9_\\-:])"
    },
    "blank-node-label": {
      "name": "variable.other.blank-node.sparql",
      "match": "_:[A-Za-z_][\\w\\-]*"
    },
    "prefixed-name": {
      "match": "([A-Za-z_][\\w\\-]*)?(:)([A-Za-z_][\\w\\-\\.]*)?",
      "captures": {
        "1": { "name": "entity.name.function.sparql" },
        "2": { "name": "punctuation.separator.namespace.sparql" },
        "3": { "name": "entity.name.type.sparql" }
      }
    },
    "path-operator": {
      "name": "keyword.operator.path.sparql",
      "match": "(?:/|\\||\\^|\\*|\\+|\\?)(?=\\s*[A-Za-z_<])|!(?=\\s*[A-Za-z_<\\(])"
    },
    "membership-operator": {
      "name": "keyword.operator.membership.sparql",
      "match": "(?i)\\b(IN|NOT\\s+IN)\\b"
    },
    "logical-operator": {
      "name": "keyword.operator.logical.sparql",
      "match": "&&|\\|\\||!=?|==?|<=?|>=?"
    },
    "arithmetic-operator": {
      "name": "keyword.operator.arithmetic.sparql",
      "match": "\\+|-|\\*|/"
    },
    "operator": {
      "patterns": [
        { "include": "#path-operator" },
        { "include": "#membership-operator" },
        { "include": "#logical-operator" },
        { "include": "#arithmetic-operator" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.sparql", "match": "\\." },
        { "name": "punctuation.separator.predicate.sparql", "match": ";" },
        { "name": "punctuation.separator.object.sparql", "match": "," },
        { "name": "punctuation.section.braces.sparql", "match": "\\{|\\}" },
        { "name": "punctuation.section.brackets.sparql", "match": "\\[|\\]" },
        { "name": "punctuation.section.parens.sparql", "match": "\\(|\\)" }
      ]
    }
  }
}
